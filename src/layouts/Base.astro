---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Illustration from '../components/Illustration.astro';
import PkgInfo from '../components/PkgInfo.astro';
import { ORG, CONTACT, LINKS, MASTODON } from '../config';

interface Props {
	title?: string;
	description?: string;
}

const {
	title,
	description = `${ORG.short} is the members' association of the OpenIndiana and illumos community. It funds infrastructure and development and gives contributors a vote in how the money is spent.`,
} = Astro.props;
const pageTitle = title ? `${title} · ${ORG.short}` : `${ORG.short} · ${ORG.name}`;
const base = import.meta.env.BASE_URL;
const home = Astro.url.pathname === base;
const section = (id: string) => (home ? `#${id}` : `${base}#${id}`);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
		<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
		<link rel="me" href={LINKS.mastodon} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf6ee" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#141110" />
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<div class="stripes spine" aria-hidden="true"></div>
		<header class="site-header">
			<div class="wrap bar">
				<Logo variant="header" />
				<nav aria-label="Main">
					<ul>
						<li><a href={section('work')}>What we do</a></li>
						<li><a href={section('membership')}>Membership</a></li>
						<li><a href={section('finances')}>Finances</a></li>
						<li><a href={`${base}bylaws/`} aria-current={Astro.url.pathname.startsWith(`${base}bylaws`) ? 'page' : undefined}>Bylaws</a></li>
					</ul>
				</nav>
				<a class="btn btn-primary donate" href={LINKS.donate}>Donate</a>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-footer band band-coal">
			<div class="wrap cols">
				<div class="colophon">
					<Logo variant="footer" />
					<p class="muted">{ORG.name}</p>
					<PkgInfo />
				</div>
				<div>
					<h2 class="mono">Contact</h2>
					<ul>
						<li><a href={`mailto:${CONTACT.info}`}>{CONTACT.info}</a></li>
						<li><a href={LINKS.mastodon} rel="me">{MASTODON.handle}</a></li>
					</ul>
				</div>
				<div>
					<h2 class="mono">Projects</h2>
					<ul>
						<li><a href={LINKS.openindiana}>OpenIndiana</a></li>
						<li><a href={LINKS.illumos}>illumos</a></li>
						<li><a href={LINKS.forge}>Source code</a></li>
					</ul>
				</div>
				<div>
					<h2 class="mono">Support</h2>
					<ul>
						<li><a href={LINKS.openCollective}>Open Collective</a></li>
						<li><a href={section('membership')}>Become a member</a></li>
						<li><a href={`${base}bylaws/`}>Bylaws</a></li>
					</ul>
				</div>
			</div>
			<div class="wrap fine mono">
				<p>This site sets no cookies and loads nothing from third parties.</p>
				<p><a href={LINKS.source}>Edit this site</a></p>
			</div>
			<div class="ember-mark" aria-hidden="true"><Illustration name="mark" /></div>
		</footer>
	</body>
</html>

<style>
	.spine { height: 0.375rem; }
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: color-mix(in srgb, var(--paper) 92%, transparent);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--rule);
	}
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 2rem;
		min-height: 4.25rem;
		flex-wrap: wrap;
		padding-block: 0.5rem;
	}
	nav { margin-left: auto; }
	nav ul {
		display: flex;
		gap: 1.25rem;
		list-style: none;
		margin: 0;
		padding: 0;
		flex-wrap: wrap;
	}
	nav ul a {
		text-decoration: none;
		font-size: 0.9375rem;
		color: var(--ink-2);
	}
	nav ul a:hover, nav ul a[aria-current] { color: var(--ink); text-decoration: underline; }
	nav ul a[aria-current] { text-decoration-color: var(--accent); text-decoration-thickness: 2px; }
	.donate { padding: 0.45em 1em; font-size: 0.9375rem; }
	@media (max-width: 52rem) {
		.donate { order: 2; }
		nav { order: 3; width: 100%; margin-left: 0; }
		nav ul { gap: 0.5rem 1.1rem; }
	}

	.site-footer {
		position: relative;
		padding-block: 4rem 2rem;
		font-size: 0.9375rem;
		overflow: hidden;
	}
	.cols {
		display: grid;
		gap: 2.5rem 2rem;
		grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
		position: relative;
		z-index: 1;
	}
	.colophon { grid-column: span 2; max-width: 26rem; }
	.colophon :global(.wordmark) { color: var(--ink); }
	.colophon :global(.pkg) { margin-top: 1.5rem; }
	@media (max-width: 40rem) {
		.colophon { grid-column: auto; }
	}
	.cols p + p { margin-top: 0.35rem; }
	.muted { color: var(--ink-2); margin-top: 0.5rem; }
	.site-footer h2 {
		font-weight: 400;
		color: var(--ink-2);
		margin-bottom: 0.75rem;
		letter-spacing: 0.02em;
	}
	.site-footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
	.site-footer a { text-decoration: none; }
	.site-footer a:hover { text-decoration: underline; color: var(--accent); }
	.fine {
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5rem 2rem;
		margin-top: 3rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--rule);
		color: var(--ink-2);
		position: relative;
		z-index: 1;
	}
	/* The phoenix as an ember in the corner: decoration only, behind the text. */
	.ember-mark {
		position: absolute;
		right: -2rem;
		bottom: -1rem;
		width: clamp(14rem, 24vw, 22rem);
		color: var(--flame);
		opacity: 0.22;
		pointer-events: none;
	}
	@media (max-width: 52rem) {
		.ember-mark { display: none; }
	}
</style>
