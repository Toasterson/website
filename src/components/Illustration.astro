---
// Illustration slots. Every picture on the site goes through this component,
// so artwork can be swapped in one place.
//
// Today both variants are the site's own abstract phoenix, generated by
// scripts/phoenix.py into src/assets/ and inlined here as SVG (no raster, no
// request, no script). They are inspired by the phoenix on the printed
// illumos books but are not copies of that artwork; see docs/redesign/.
//
//   hero  The large painted phoenix crossing a beam of light (home page).
//   mark  A one-colour silhouette that takes `currentColor` (footer, cards).
//
// Should the cover artwork become available under a free licence, replace
// the `hero` branch with it and add the attribution in Base.astro's footer.
import PhoenixHero from '../assets/phoenix-hero.svg';
import PhoenixMark from '../assets/phoenix-mark.svg';

interface Props {
	name: 'hero' | 'mark';
	class?: string;
}
const { name, class: className } = Astro.props;
---

{name === 'hero' && <PhoenixHero class:list={['illustration', 'hero', className]} />}
{name === 'mark' && <PhoenixMark class:list={['illustration', 'mark', className]} />}

<style>
	.illustration { display: block; height: auto; }
	.hero { width: 100%; }
	.mark { width: 100%; }
</style>
