---
// The logo slot. OIDA's logo is being designed in the brand repository
// (https://src.oida.foundation/oida/brand, wayfinder map on its issue
// tracker). Until that work lands, this renders the text wordmark; replace
// the inside of this component with the brand outcome and nothing else on
// the site has to change. Keep the phoenix illustrations separate from the
// logo: they are decoration, not a mark.
import { ORG } from '../config';

interface Props {
	/** 'header' shows the full name next to the wordmark; 'footer' only the wordmark. */
	variant?: 'header' | 'footer';
}
const { variant = 'header' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<a class:list={['wordmark', variant]} href={base} aria-label={`${ORG.short} home`}>
	<span class="mark">{ORG.short}</span>
	{variant === 'header' && (
		<span class="full">OpenIndiana &amp; illumos<br />community Development Association</span>
	)}
</a>

<style>
	.wordmark {
		display: inline-flex;
		align-items: center;
		gap: 0.85rem;
		text-decoration: none;
		color: var(--ink);
	}
	.wordmark:hover { color: var(--ink); }
	.mark {
		font-family: var(--mono);
		font-weight: 600;
		font-size: 1.375rem;
		letter-spacing: 0.12em;
	}
	.full {
		font-size: 0.75rem;
		line-height: 1.3;
		color: var(--ink-2);
		border-left: 1px solid var(--rule);
		padding-left: 0.85rem;
	}
	@media (max-width: 40rem) {
		.full { display: none; }
	}
</style>
